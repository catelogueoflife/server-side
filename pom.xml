<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <packaging>pom</packaging>
    <modules>
        <module>dao</module>
        <module>common</module>
        <module>manager-web</module>
        <module>spider</module>
        <module>es-common</module>
    </modules>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.13</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.touchkiss.catelogueoflife</groupId>
    <artifactId>catelogue-of-life</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>catelogue-of-life</name>
    <description>catelogue-of-life</description>

    <properties>
        <java.version>21</java.version>
        <gson.version>2.11.0</gson.version>
        <mybatis.version>3.5.19</mybatis.version>
        <mybatis.spring.boot.version>3.0.4</mybatis.spring.boot.version>
        <pagehelper.version>6.1.0</pagehelper.version>
        <pagehelper.spring.boot.version>2.1.0</pagehelper.spring.boot.version>
        <commons.io.version>2.17.0</commons.io.version>
        <httpclient.version>4.5.14</httpclient.version>
        <mysql.connector.version>8.4.0</mysql.connector.version>
        <druid.version>1.2.25</druid.version>
        <elasticsearch.version>7.17.26</elasticsearch.version>
        <jsoup.version>1.17.2</jsoup.version>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <testFailureIgnore>false</testFailureIgnore>
                    <skipTests>false</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
